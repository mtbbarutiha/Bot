# petdate — Environment

# ── App ──
NODE_ENV=development
WEB_URL=http://localhost:5173
API_URL=http://localhost:3001
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=

# ── API ──
PORT=3001

# PostgreSQL + PostGIS (primary DB)
DATABASE_URL=postgresql://petdate:petdate@localhost:5432/petdate

# Legacy SQLite (فاز گذار — API فعلی)
DATABASE_PATH=./packages/api/data/petdate.db

# Redis — session bot، presence، match queue
REDIS_URL=redis://localhost:6379

# MinIO / S3 — عکس‌ها و backup
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=petdate-media
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/petdate-media

# Elasticsearch — فاز بعد (search پیشرفته؛ profile: search)
ELASTICSEARCH_URL=http://localhost:9200

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=your_bot_username

# ── Payments (فاز بعد — مشاوره دامپزشک) ──
# PAYMENT_PROVIDER=
# PAYMENT_API_KEY=
